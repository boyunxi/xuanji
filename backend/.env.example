# ==============================================================================
#  璇玑 · 游戏运营后台 (Xuanji Operations) 环境变量示例配置
# ==============================================================================

# 运营后台固定登录账号与密码
AUTH_USERNAME=admin
AUTH_PASSWORD=xuanji2026

# 后端服务端口 (默认 8080)
PORT=8080

# 数据持久化目录 (默认 ./data)
DATA_DIR=./data

# PostgreSQL 数据库配置 (WSL 本地服务)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=xuanji
PG_PASSWORD=xuanji_pass
PG_DBNAME=xuanji
PG_SSLMODE=disable

# Redis 缓存配置 (WSL 本地服务)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# ==============================================================================
#  游戏服务器驱动与接入网关配置 (Game Server Integration Gateway)
# ==============================================================================
# 驱动模式: mock (离线仿真，默认无需外接游戏服) | http (REST/Webhook) | redis (Pub/Sub事件总线) | hybrid (定向HTTP+广播Redis)
GAME_SERVER_DRIVER=mock

# 默认游戏服 HTTP API 基地址 (用于 http / hybrid 模式)
GAME_SERVER_HTTP_URL=http://127.0.0.1:9000

# 鉴权机制: none | bearer | header | hmac_sha256 | md5
GAME_SERVER_AUTH_TYPE=none

# 签名密钥或认证 Token
GAME_SERVER_SECRET=your_hmac_secret_here
GAME_SERVER_TOKEN=your_auth_token_here

# 自定义 Header 鉴权名称 (默认 X-GM-Token)
GAME_SERVER_HEADER_NAME=X-GM-Token

# 多区服分流路由 (JSON 格式，游戏区服名 -> 目标游戏服地址)
# GAME_SERVER_SERVERS_JSON={"山海长歌":"http://10.0.1.10:9000","九州志":"http://10.0.1.11:9000"}
GAME_SERVER_SERVERS_JSON=
